{
  "name": "@andrueandersoncs/lint-anything",
  "version": "0.1.1",
  "description": "Check anything against plain-English policies, judged by Cloudflare's Clef decision model",
  "license": "MIT",
  "author": "Andrue Anderson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrueandersoncs/lint-anything.git"
  },
  "homepage": "https://github.com/andrueandersoncs/lint-anything#readme",
  "bugs": "https://github.com/andrueandersoncs/lint-anything/issues",
  "type": "module",
  "bin": {
    "lint-anything": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "skills"
  ],
  "engines": {
    "bun": ">=1.2.23"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build index.ts --target=bun --minify --outfile dist/cli.js",
    "prepublishOnly": "bunx tsc --noEmit && bun run build"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51.0",
    "@effect/platform-bun": "4.0.5",
    "@types/bun": "latest",
    "effect": "4.0.5",
    "typescript": "^7"
  },
  "trustedDependencies": [
    "@ast-grep/cli"
  ]
}
